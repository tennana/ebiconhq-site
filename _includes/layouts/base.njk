<!DOCTYPE html>
<html lang="{{ site.meta.lang }}">
<head prefix="og: http://ogp.me/ns#">
  {% set socialTitle = title or site.meta.title %}
  {% set documentTitle %}{% if title %}{{ title }} | {{ site.meta.title }}{% else %}{{ site.meta.title }}{% endif %}{% endset %}
  {% set metaDescription = card_description or description or site.meta.description %}
  {% set type = "website" if page.url == '/' else "article" %}
  {% metagen
    title=documentTitle | escape,
    og_title=socialTitle | escape,
    twitter_title=socialTitle | escape,
    desc=metaDescription | escape,
    locale="ja_JP",
    url=(site.meta.siteUrl + page.url) | escape,
    img=(card_image or (site.meta.siteUrl + "/static/img/twitter_card.jpg")) | escape,
    type=type,
    img_alt="#trpg_ebicon",
    twitter_card_type="summary",
    twitter_handle="tennana_tef",
    name="Ebicon HQ",
    site_name=site.meta.title | escape,
    generator="eleventy"
  %}
  <link rel="alternate" type="application/atom+xml" href="{{ site.feed.path | url }}" title="Atom 最近のえびこん Feed" />
  <link rel="alternate" type="application/rss+xml" href="{{ site.feed.rss2path | url }}" title="RSS2.0 最近のえびこん Feed" />
  <link rel="shortcut icon" href="{{ '/static/img/favicon.ico' | url }}" type="image/x-icon">
  <link rel="stylesheet" href="{{ '/static/css/main.css' | url }}" media="all">
  {% eleventyGoogleFonts "https://fonts.googleapis.com/css2?family=Kosugi+Maru&display=swap" %}
</head>
<body>
  {% include 'components/navbar.njk' %}
  {{ content | safe }}
  {% include 'components/footer.njk' %}
  <script src="{{ '/static/base.js' | url }}" async></script>
</body>
</html>
